# Version Configuration
# Source of truth for the versions used by Busybee's local stack and generated code

# Camunda and ElasticSearch images for docker-compose.yml (CI overrides ZEEBE_VERSION per job)
ZEEBE_VERSION=8.10.9
ELASTICSEARCH_VERSION=8.19.25

# Camunda tag whose gateway.proto generates lib/busybee/grpc/ (rake grpc:generate)
GRPC_PROTO_VERSION=8.10.9
