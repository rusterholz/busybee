<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.43.1">
  <bpmn:message id="Message_driver_available" name="driver_available">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= driver_request.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="deliver_shipment" name="Deliver Shipment" isExecutable="true">
    <bpmn:startEvent id="start" name="Start:&#10;Shipment Packed">
      <bpmn:outgoing>Flow_ToSplit1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSplit1" sourceRef="start" targetRef="prepare_delivery" />
    <bpmn:parallelGateway id="prepare_delivery">
      <bpmn:incoming>Flow_ToSplit1</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBranchA</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBranchB</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_ToBranchA" sourceRef="prepare_delivery" targetRef="load_order_address" />
    <bpmn:serviceTask id="load_order_address" name="Load Order Address">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="load_order_address" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.order_id" target="order_id" />
          <zeebe:output source="= lat" target="destination.lat" />
          <zeebe:output source="= lon" target="destination.lon" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBranchA</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalcDeliveryDist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCalcDeliveryDist" sourceRef="load_order_address" targetRef="calculate_distance" />
    <bpmn:serviceTask id="calculate_distance" name="Calculate Delivery Distance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate_distance" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="algorithm" value="pythagorean" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.warehouse.address.lat" target="from_lat" />
          <zeebe:input source="= shipment.warehouse.address.lon" target="from_lon" />
          <zeebe:input source="= destination.lat" target="to_lat" />
          <zeebe:input source="= destination.lon" target="to_lon" />
          <zeebe:output source="= distance" target="shipment.distance" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCalcDeliveryDist</bpmn:incoming>
      <bpmn:outgoing>Flow_BranchAToJoin1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_BranchAToJoin1" sourceRef="calculate_distance" targetRef="ready_to_deliver" />
    <bpmn:sequenceFlow id="Flow_ToBranchB" sourceRef="prepare_delivery" targetRef="assign_driver" />
    <bpmn:serviceTask id="assign_driver" name="Assign Driver">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assign_driver" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.id" target="shipment_id" />
          <zeebe:output source="= driver_id" target="driver.id" />
          <zeebe:output source="= driver_name" target="driver.name" />
          <zeebe:output source="= request_id" target="driver_request.id" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBranchB</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDriverGw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDriverGw" sourceRef="assign_driver" targetRef="driver_assigned" />
    <bpmn:exclusiveGateway id="driver_assigned" name="Driver Assigned?" default="Flow_NoDriver">
      <bpmn:incoming>Flow_ToDriverGw</bpmn:incoming>
      <bpmn:outgoing>Flow_DriverAssigned</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoDriver</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DriverAssigned" name="Yes" sourceRef="driver_assigned" targetRef="driver_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= driver.id != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoDriver" name="No" sourceRef="driver_assigned" targetRef="wait_for_driver" />
    <bpmn:intermediateCatchEvent id="wait_for_driver" name="Wait for&#10;Driver">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= driver_id" target="driver.id" />
          <zeebe:output source="= driver_name" target="driver.name" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoDriver</bpmn:incoming>
      <bpmn:outgoing>Flow_DriverAvailable</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_driver_available" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_DriverAvailable" sourceRef="wait_for_driver" targetRef="driver_merge" />
    <bpmn:exclusiveGateway id="driver_merge">
      <bpmn:incoming>Flow_DriverAssigned</bpmn:incoming>
      <bpmn:incoming>Flow_DriverAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_DriverMergeToJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DriverMergeToJoin" sourceRef="driver_merge" targetRef="ready_to_deliver" />
    <bpmn:parallelGateway id="ready_to_deliver">
      <bpmn:incoming>Flow_BranchAToJoin1</bpmn:incoming>
      <bpmn:incoming>Flow_DriverMergeToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMarkInTransit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_ToMarkInTransit" sourceRef="ready_to_deliver" targetRef="mark_shipment_in_transit" />
    <bpmn:serviceTask id="mark_shipment_in_transit" name="Mark In Transit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update_shipment_status" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="status" value="in_transit" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.id" target="shipment_id" />
          <zeebe:input source="= shipment.order_id" target="order_id" />
          <zeebe:output source="= first_in_transit" target="shipment.was_first_in_transit" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToMarkInTransit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTransitGw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="first_shipment_in_transit" name="First In Transit?" default="Flow_NotFirstInTransit">
      <bpmn:incoming>Flow_ToTransitGw</bpmn:incoming>
      <bpmn:outgoing>Flow_FirstInTransit</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotFirstInTransit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_FirstInTransit" name="Yes" sourceRef="first_shipment_in_transit" targetRef="mark_order_shipping">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= shipment.was_first_in_transit = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="mark_order_shipping" name="Mark Order Shipping">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update_order_status" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="status" value="shipping" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.order_id" target="order_id" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FirstInTransit</bpmn:incoming>
      <bpmn:outgoing>Flow_ShippingToTransitMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ShippingToTransitMerge" sourceRef="mark_order_shipping" targetRef="simulate_delivery_run" />
    <bpmn:sequenceFlow id="Flow_NotFirstInTransit" name="No" sourceRef="first_shipment_in_transit" targetRef="simulate_delivery_run" />
    <bpmn:serviceTask id="simulate_delivery_run" name="Deliver Shipment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="simulate_delivery_run" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.id" target="shipment_id" />
          <zeebe:input source="= shipment.distance" target="distance" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotFirstInTransit</bpmn:incoming>
      <bpmn:incoming>Flow_ShippingToTransitMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSplit2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSplit2" sourceRef="simulate_delivery_run" targetRef="after_delivery" />
    <bpmn:parallelGateway id="after_delivery">
      <bpmn:incoming>Flow_ToSplit2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBranchC</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBranchD</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_ToBranchC" sourceRef="after_delivery" targetRef="mark_shipment_delivered" />
    <bpmn:serviceTask id="mark_shipment_delivered" name="Mark Shipment Delivered">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update_shipment_status" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="status" value="delivered" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.id" target="shipment_id" />
          <zeebe:input source="= shipment.order_id" target="order_id" />
          <zeebe:output source="= all_delivered" target="shipment.was_final_delivery" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBranchC</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExclusiveGw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToExclusiveGw" sourceRef="mark_shipment_delivered" targetRef="all_shipments_delivered" />
    <bpmn:exclusiveGateway id="all_shipments_delivered" name="All Shipments Delivered?" default="Flow_NotAllDelivered">
      <bpmn:incoming>Flow_ToExclusiveGw</bpmn:incoming>
      <bpmn:outgoing>Flow_AllDelivered</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotAllDelivered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_AllDelivered" name="Yes" sourceRef="all_shipments_delivered" targetRef="mark_order_fulfilled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= shipment.was_final_delivery = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="mark_order_fulfilled" name="Mark Order Fulfilled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update_order_status" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="status" value="fulfilled" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= shipment.order_id" target="order_id" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AllDelivered</bpmn:incoming>
      <bpmn:outgoing>Flow_FulfilledToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToBranchD" sourceRef="after_delivery" targetRef="complete_driver_delivery" />
    <bpmn:serviceTask id="complete_driver_delivery" name="Complete Driver Delivery">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="complete_driver_delivery" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= driver.id" target="driver_id" />
          <zeebe:input source="= shipment.id" target="shipment_id" />
          <zeebe:input source="= shipment.distance" target="distance" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBranchD</bpmn:incoming>
      <bpmn:outgoing>Flow_BranchDToJoin2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_BranchDToJoin2" sourceRef="complete_driver_delivery" targetRef="para_merge" />
    <bpmn:exclusiveGateway id="order_merge">
      <bpmn:incoming>Flow_FulfilledToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_NotAllDelivered</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderMergeToJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_OrderMergeToJoin" sourceRef="order_merge" targetRef="para_merge" />
    <bpmn:parallelGateway id="para_merge">
      <bpmn:incoming>Flow_BranchDToJoin2</bpmn:incoming>
      <bpmn:incoming>Flow_OrderMergeToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="para_merge" targetRef="end" />
    <bpmn:endEvent id="end" name="End:&#10;Shipment Delivered">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToTransitGw" sourceRef="mark_shipment_in_transit" targetRef="first_shipment_in_transit" />
    <bpmn:sequenceFlow id="Flow_NotAllDelivered" name="No" sourceRef="all_shipments_delivered" targetRef="order_merge" />
    <bpmn:sequenceFlow id="Flow_FulfilledToMerge" sourceRef="mark_order_fulfilled" targetRef="order_merge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="deliver_shipment">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="start">
        <dc:Bounds x="192" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="167" y="252" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelSplit1_di" bpmnElement="prepare_delivery">
        <dc:Bounds x="265" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadOrderAddress_di" bpmnElement="load_order_address">
        <dc:Bounds x="350" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalcDeliveryDistance_di" bpmnElement="calculate_distance">
        <dc:Bounds x="490" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignDriver_di" bpmnElement="assign_driver">
        <dc:Bounds x="350" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGw_DriverAssigned_di" bpmnElement="driver_assigned" isMarkerVisible="true">
        <dc:Bounds x="480" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="461" y="262" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForDriver_di" bpmnElement="wait_for_driver">
        <dc:Bounds x="492" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="82" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGw_DriverMerge_di" bpmnElement="driver_merge" isMarkerVisible="true">
        <dc:Bounds x="565" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelJoin1_di" bpmnElement="ready_to_deliver">
        <dc:Bounds x="655" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkInTransit_di" bpmnElement="mark_shipment_in_transit">
        <dc:Bounds x="740" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGw_FirstInTransit_di" bpmnElement="first_shipment_in_transit" isMarkerVisible="true">
        <dc:Bounds x="880" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="867" y="265" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeliveryRun_di" bpmnElement="simulate_delivery_run">
        <dc:Bounds x="970" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelSplit2_di" bpmnElement="after_delivery">
        <dc:Bounds x="1105" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkShipmentDelivered_di" bpmnElement="mark_shipment_delivered">
        <dc:Bounds x="1080" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGw_AllDelivered_di" bpmnElement="all_shipments_delivered" isMarkerVisible="true">
        <dc:Bounds x="1225" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1216" y="285" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkOrderFulfilled_di" bpmnElement="mark_order_fulfilled">
        <dc:Bounds x="1320" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CompleteDriverDelivery_di" bpmnElement="complete_driver_delivery">
        <dc:Bounds x="1320" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGw_OrderMerge_di" bpmnElement="order_merge" isMarkerVisible="true">
        <dc:Bounds x="1445" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelJoin2_di" bpmnElement="para_merge">
        <dc:Bounds x="1545" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="end">
        <dc:Bounds x="1632" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1627" y="253" width="47" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkOrderShipping_di" bpmnElement="mark_order_shipping">
        <dc:Bounds x="970" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSplit1_di" bpmnElement="Flow_ToSplit1">
        <di:waypoint x="228" y="230" />
        <di:waypoint x="265" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToBranchA_di" bpmnElement="Flow_ToBranchA">
        <di:waypoint x="290" y="255" />
        <di:waypoint x="290" y="340" />
        <di:waypoint x="350" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCalcDeliveryDist_di" bpmnElement="Flow_ToCalcDeliveryDist">
        <di:waypoint x="450" y="340" />
        <di:waypoint x="490" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BranchAToJoin1_di" bpmnElement="Flow_BranchAToJoin1">
        <di:waypoint x="590" y="340" />
        <di:waypoint x="680" y="340" />
        <di:waypoint x="680" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToBranchB_di" bpmnElement="Flow_ToBranchB">
        <di:waypoint x="315" y="230" />
        <di:waypoint x="350" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDriverGw_di" bpmnElement="Flow_ToDriverGw">
        <di:waypoint x="450" y="230" />
        <di:waypoint x="480" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DriverAssigned_di" bpmnElement="Flow_DriverAssigned">
        <di:waypoint x="530" y="230" />
        <di:waypoint x="565" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="237" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoDriver_di" bpmnElement="Flow_NoDriver">
        <di:waypoint x="505" y="205" />
        <di:waypoint x="505" y="148" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="511" y="174" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DriverAvailable_di" bpmnElement="Flow_DriverAvailable">
        <di:waypoint x="528" y="130" />
        <di:waypoint x="590" y="130" />
        <di:waypoint x="590" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DriverMergeToJoin_di" bpmnElement="Flow_DriverMergeToJoin">
        <di:waypoint x="615" y="230" />
        <di:waypoint x="655" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToMarkInTransit_di" bpmnElement="Flow_ToMarkInTransit">
        <di:waypoint x="705" y="230" />
        <di:waypoint x="740" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTransitGw_di" bpmnElement="Flow_ToTransitGw">
        <di:waypoint x="840" y="230" />
        <di:waypoint x="880" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FirstInTransit_di" bpmnElement="Flow_FirstInTransit">
        <di:waypoint x="905" y="205" />
        <di:waypoint x="905" y="120" />
        <di:waypoint x="970" y="120" />
