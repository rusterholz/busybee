<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="5">
  <title>Busybee Monitoring · Dropship Co.</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"
          integrity="sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"
          integrity="sha384-cVMg8E3QFwTvGCDuK+ET4PD341jF3W8nO1auiXfuZNQkzbUUiBGLsIQUE+b1mxws" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"
          integrity="sha384-I6Nc3JqKT6SpS77pwiXs+Va8ueZqCRmJ8QvsKVmZ0uMX3ecQncKxBQBlUHebqlKT" crossorigin="anonymous"></script>
  <script>
    Chart.defaults.color = "#898781";
    Chart.defaults.borderColor = "#2c2c2a";
    Chart.defaults.font.family = 'ui-monospace, "SF Mono", Menlo, monospace';
    Chart.defaults.font.size = 11;

    // Every time on the page in the browser's zone, the one Chart.js draws its axes in.
    document.addEventListener("DOMContentLoaded", () => {
      const seconds = { hour: "numeric", minute: "2-digit", second: "2-digit" };
      document.querySelectorAll("time[data-local]").forEach((el) => {
        const options = el.dataset.local === "millis" ? { ...seconds, fractionalSecondDigits: 3 } : seconds;
        el.textContent = new Date(el.getAttribute("datetime")).toLocaleTimeString([], options);
      });
      document.querySelectorAll("[data-time-zone]").forEach((el) => {
        el.textContent = Intl.DateTimeFormat().resolvedOptions().timeZone;
      });
    });
  </script>
  <%= csrf_meta_tags %>
  <style>
    :root { --pico-font-size: 16px; }
    body { font-family: ui-monospace, "SF Mono", Menlo, monospace; }
    nav ul { margin-bottom: 0; }
    main.container { max-width: 1200px; }
    .ops-tag { color: var(--pico-primary); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.75rem; }

    section { margin-bottom: 2.5rem; }
    section > h2 small { color: var(--pico-muted-color); font-weight: normal; }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { padding: 1rem; border: 1px solid var(--pico-muted-border-color); border-radius: var(--pico-border-radius); text-align: center; }
    .stat-card h2 { margin-bottom: 0.25rem; }
    .stat-card small { color: var(--pico-muted-color); }

    <% MonitoringHelper::STATUS_COLORS.each do |status, color| %>
    .status-<%= status %> { color: <%= color %>; }
    <% end %>

    /* Tabs and the one filter row */
    .tabs { display: flex; justify-content: flex-start; gap: 1.5rem; border-bottom: 1px solid var(--pico-muted-border-color); margin-bottom: 1rem; }
    .tabs a { padding: 0.4rem 0; text-decoration: none; color: var(--pico-muted-color); border-bottom: 2px solid transparent; }
    .tabs a[aria-current] { color: var(--pico-color); border-bottom-color: var(--pico-primary); }
    .filter-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; margin-bottom: 1.5rem; }
    .filter-row label { margin-bottom: 0; font-size: 0.8rem; color: var(--pico-muted-color); min-width: 14rem; }
    .filter-row select { margin-bottom: 0; font-size: 0.85rem; padding-top: 0.4rem; padding-bottom: 0.4rem; }
    .filter-row .clear { font-size: 0.8rem; padding-bottom: 0.5rem; }
    .filter-row .zone { margin-left: auto; padding-bottom: 0.5rem; color: var(--pico-muted-color); font-size: 0.75rem; }
    .ranges { display: inline-flex; width: auto; margin-bottom: 0; border: 1px solid var(--pico-muted-border-color); border-radius: var(--pico-border-radius); overflow: hidden; }
    .ranges a { padding: 0.45rem 0.9rem; text-decoration: none; color: var(--pico-muted-color); font-size: 0.85rem; }
    .ranges a[aria-current] { background: var(--pico-primary-background); color: var(--pico-primary-inverse); }

    /* Charts */
    .chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 1.5rem; }
    .chart-card { margin-bottom: 1.5rem; }
    .chart-card h3 { font-size: 0.9rem; margin-bottom: 0.25rem; }
    .chart-card p, .caption { font-size: 0.75rem; color: var(--pico-muted-color); margin-bottom: 0.5rem; }
    .local-toggle { font-size: 0.8rem; font-weight: normal; margin-left: 1rem; }

    /* Worker lifecycle phases */
    .wstatus-running        { color: #4ade80; }
    .wstatus-stop_requested,
    .wstatus-stopping       { color: #fbbf24; }
    .wstatus-shutdown       { color: #94a3b8; }

    .badge { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.1rem 0.45rem;
             border-radius: 0.6rem; background: var(--pico-muted-border-color); color: var(--pico-muted-color); white-space: nowrap; }
    .badge.rollover  { color: #38bdf8; }
    .badge.unhealthy { color: #fbbf24; }
    .badge.crash     { color: #f87171; }

    table { width: 100%; font-size: 0.82rem; }
    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
    td.mono { font-variant-numeric: tabular-nums; }

    /* Per-job engine-call sequence */
    .call-seq { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.15rem 0 0.4rem 1rem; }
    .call-pill { font-size: 0.72rem; padding: 0.08rem 0.5rem; border-radius: 0.7rem; border: 1px solid var(--pico-muted-border-color); white-space: nowrap; }
    .call-pill.errored { border-color: #f87171; color: #f87171; }
    .call-pill .ms { color: var(--pico-muted-color); margin-left: 0.35rem; }

    .filters { margin-bottom: 1.5rem; }
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: start; }
    .filter-grid label { margin-bottom: 0; }

    /* Navbar "how live?" chip */
    .liveness { display: flex; align-items: center; gap: 0.55rem; font-size: 0.72rem; color: var(--pico-muted-color); }
    .liveness .metric b { color: var(--pico-color); font-variant-numeric: tabular-nums; }
    .liveness .dot { width: 0.62rem; height: 0.62rem; border-radius: 50%; display: inline-block; }
    .dot-fresh { background: #4ade80; } .dot-lagging { background: #fbbf24; } .dot-stale { background: #f87171; }
    .empty { color: var(--pico-muted-color); font-style: italic; }
  </style>
</head>
<body>
  <header class="container">
    <nav>
      <ul>
        <li><strong><a href="<%= monitoring_path %>">busybee // Monitoring</a></strong></li>
      </ul>
      <ul>
        <% if @liveness %>
          <%
            running = @liveness.running_count
            depth = @liveness.max_queue_depth || 0
            health = if depth > 10 then "stale"
                     elsif depth > 3 then "lagging"
                     else "fresh"
                     end
          %>
          <li class="liveness" title="Workers whose last lifecycle event left them running, and the recorders' write-queue backlog across them. A deep queue means these numbers lag reality.">
            <% if running.zero? %>
              <span class="empty">no running workers</span>
            <% else %>
              <span class="dot dot-<%= health %>"></span>
              <span class="metric"><b><%= running %></b> running</span>
              <span class="metric">· write queue <b><%= depth %></b> max · <b><%= (@liveness.mean_queue_depth || 0).round(1) %></b> mean</span>
            <% end %>
          </li>
        <% end %>
        <li><a href="<%= root_path %>">← Dropship Co.</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">
    <%= render "monitoring/filters" %>
    <%= yield %>
  </main>

  <footer class="container">
    <small>What busybee is doing, recorded via lifecycle hooks, not the business app.</small>
  </footer>
</body>
</html>
