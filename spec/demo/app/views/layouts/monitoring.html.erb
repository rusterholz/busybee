<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="5">
  <title>Busybee Monitoring — Dropship Co.</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <%= csrf_meta_tags %>
  <style>
    :root { --pico-font-size: 16px; }
    body { font-family: ui-monospace, "SF Mono", Menlo, monospace; }
    nav ul { margin-bottom: 0; }
    main.container { max-width: 1200px; }
    .ops-tag { color: var(--pico-primary); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.75rem; }

    section { margin-bottom: 2.5rem; }
    section > h2 small { color: var(--pico-muted-color); font-weight: normal; }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { padding: 1rem; border: 1px solid var(--pico-muted-border-color); border-radius: var(--pico-border-radius); text-align: center; }
    .stat-card h2 { margin-bottom: 0.25rem; }
    .stat-card small { color: var(--pico-muted-color); }

    .status-ready    { color: #94a3b8; }
    .status-complete { color: #4ade80; }
    .status-failed   { color: #f87171; }
    .status-error    { color: #fbbf24; }

    /* Worker lifecycle phases */
    .wstatus-running        { color: #4ade80; }
    .wstatus-stop_requested,
    .wstatus-stopping       { color: #fbbf24; }
    .wstatus-shutdown       { color: #94a3b8; }

    .badge { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.1rem 0.45rem;
             border-radius: 0.6rem; background: var(--pico-muted-border-color); color: var(--pico-muted-color); white-space: nowrap; }
    .badge.rollover  { color: #38bdf8; }
    .badge.unhealthy { color: #fbbf24; }
    .badge.crash     { color: #f87171; }

    table { width: 100%; font-size: 0.82rem; }
    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
    td.mono { font-variant-numeric: tabular-nums; }

    /* Per-job engine-call sequence */
    .call-seq { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.15rem 0 0.4rem 1rem; }
    .call-pill { font-size: 0.72rem; padding: 0.08rem 0.5rem; border-radius: 0.7rem; border: 1px solid var(--pico-muted-border-color); white-space: nowrap; }
    .call-pill.errored { border-color: #f87171; color: #f87171; }
    .call-pill .ms { color: var(--pico-muted-color); margin-left: 0.35rem; }

    .filters { margin-bottom: 1.5rem; }
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: start; }
    .filter-grid label { margin-bottom: 0; }

    /* Navbar "how live?" chip */
    .liveness { display: flex; align-items: center; gap: 0.55rem; font-size: 0.72rem; color: var(--pico-muted-color); }
    .liveness .metric b { color: var(--pico-color); font-variant-numeric: tabular-nums; }
    .liveness .dot { width: 0.62rem; height: 0.62rem; border-radius: 50%; display: inline-block; }
    .dot-fresh { background: #4ade80; } .dot-lagging { background: #fbbf24; } .dot-stale { background: #f87171; }
    .empty { color: var(--pico-muted-color); font-style: italic; }
  </style>
</head>
<body>
  <header class="container">
    <nav>
      <ul>
        <li><strong><a href="<%= monitoring_path %>">busybee // Monitoring</a></strong></li>
      </ul>
      <ul>
        <% if @liveness %>
          <%
            fresh = @liveness.freshness_s
            depth = @liveness.max_queue_depth || 0
            health = if fresh.nil? then "stale"
                     elsif fresh > 30 || depth > 10 then "stale"
                     elsif fresh > 10 || depth > 3 then "lagging"
                     else "fresh"
                     end
          %>
          <li class="liveness" title="Recorder write-queue backlog across running workers, and seconds since the freshest write. A deep queue or a stale timestamp means these numbers lag reality.">
            <span class="dot dot-<%= health %>"></span>
            <% if fresh.nil? %>
              <span class="empty">no workers yet</span>
            <% else %>
              <span class="metric">write queue <b><%= @liveness.max_queue_depth || 0 %></b> max · <b><%= (@liveness.mean_queue_depth || 0).round(1) %></b> mean</span>
              <span class="metric">· fresh <b><%= fresh.round %></b>s ago</span>
            <% end %>
          </li>
        <% end %>
        <li><a href="<%= root_path %>">← Dropship Co.</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">
    <%= yield %>
  </main>

  <footer class="container">
    <small>What busybee is doing — recorded via lifecycle hooks, not the business app.</small>
  </footer>
</body>
</html>
