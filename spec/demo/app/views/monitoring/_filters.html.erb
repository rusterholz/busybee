<%# The tabs and the one filter row: every chart and table on the page follows it. %>
<nav class="tabs" aria-label="Monitoring pages">
  <% { "Workers" => :monitoring_workers_path, "Workflows" => :monitoring_workflows_path,
       "Infrastructure" => :monitoring_infrastructure_path }.each do |label, route| %>
    <% path = public_send(route) %>
    <a href="<%= public_send(route, filter_params) %>" <%= 'aria-current="page"'.html_safe if request.path == path %>><%= label %></a>
  <% end %>
</nav>

<form method="get" action="<%= request.path %>" class="filter-row">
  <div class="ranges" role="group" aria-label="Range">
    <% Monitoring::Window::KEYS.each do |key| %>
      <a href="<%= url_for(request.query_parameters.merge("range" => key).compact_blank) %>"
         <%= 'aria-current="true"'.html_safe if @window.key == key %>><%= key %></a>
    <% end %>
  </div>
  <input type="hidden" name="range" value="<%= @window.key %>">
  <% request.query_parameters.except(*MonitoringController::FILTERS).compact_blank.each do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= value %>">
  <% end %>
  <label>
    Job type
    <select name="job_type" onchange="this.form.submit()">
      <option value="">All job types</option>
      <% (@job_types | [@job_type].compact).each do |job_type| %>
        <option value="<%= job_type %>" <%= "selected" if @job_type == job_type %>><%= job_type %></option>
      <% end %>
    </select>
  </label>
  <label>
    Workflow
    <select name="workflow" onchange="this.form.submit()">
      <option value="">All workflows</option>
      <% (@workflows | [@workflow].compact).each do |workflow| %>
        <option value="<%= workflow %>" <%= "selected" if @workflow == workflow %>><%= workflow %></option>
      <% end %>
    </select>
  </label>
  <% if filter_params.except("range").any? %>
    <a href="<%= url_for(filter_params.slice("range")) %>" class="clear">Clear filters</a>
  <% end %>
</form>
