<%
  fmt_ms   = ->(ms) { ms.nil? ? "—" : number_with_delimiter(ms.round(1)) }
  fmt_int  = ->(n)  { n.nil? ? "—" : number_with_delimiter(n) }
  lifetime = ->(w)  { w.started_at ? "#{((w.shutdown_at || Time.current) - w.started_at).round}s" : "—" }
%>

<hgroup>
  <h1>What busybee is doing</h1>
  <p>Every job, worker, and engine call the platform runs — recorded by the lifecycle hooks this app registers, the same way you'd wire a Datadog or OpenTelemetry sink in production.</p>
</hgroup>

<section>
  <div class="stat-grid">
    <article class="stat-card"><h2><%= @stats.total_count %></h2><small>jobs</small></article>
    <% @stats.counts_by_status.each do |status, count| %>
      <article class="stat-card"><h2 class="status-<%= status %>"><%= count %></h2><small><%= status %></small></article>
    <% end %>
    <article class="stat-card"><h2><%= fmt_int.(@call_stats.total_calls) %></h2><small>engine calls</small></article>
    <article class="stat-card"><h2><%= @calls_per_job.round(1) %></h2><small>calls / job</small></article>
    <article class="stat-card"><h2><%= @stats.buffered_count %></h2><small>buffered</small></article>
  </div>
</section>

<section>
  <h2>Workers <small>— every incarnation, newest first (a rolled worker leaves its predecessor here)</small></h2>
  <% if @workers.any? %>
    <table>
      <thead>
        <tr>
          <th>Worker</th><th>Job type</th><th>Phase</th><th>Reason</th>
          <th class="num">Jobs</th><th class="num">Failed</th><th class="num">Backpressure</th>
          <th class="num">Buffer</th><th class="num">Peak</th><th class="num">Write&nbsp;q</th>
          <th class="num">Lifetime</th><th>Error</th>
        </tr>
      </thead>
      <tbody>
        <% @workers.each do |w| %>
          <tr>
            <td class="mono"><%= w.worker_name %></td>
            <td><code><%= w.job_type %></code></td>
            <td class="wstatus-<%= w.status %>"><%= w.status %></td>
            <td><% if w.reason %><span class="badge <%= w.reason %>"><%= w.reason %></span><% end %></td>
            <td class="num"><%= fmt_int.(w.total_job_count) %></td>
            <td class="num"><%= fmt_int.(w.failed_job_count) %></td>
            <td class="num"><%= fmt_int.(w.backpressure_count) %></td>
            <td class="num"><%= w.current_buffer_size.nil? ? "—" : w.current_buffer_size %></td>
            <td class="num"><%= w.peak_buffer_size.nil? ? "—" : w.peak_buffer_size %></td>
            <td class="num"><%= w.write_queue_depth.nil? ? "—" : w.write_queue_depth %></td>
            <td class="num"><%= lifetime.(w) %></td>
            <td><%= w.error_class %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">No workers have reported yet.</p>
  <% end %>
</section>

<section>
  <h2>Engine calls <small>— gRPC to the Zeebe gateway, the low-cardinality aggregate (context_tags)</small></h2>
  <% if @call_stats.by_rpc.any? %>
    <div class="grid">
      <div>
        <table>
          <thead><tr><th>RPC</th><th class="num">Calls</th><th class="num">Mean</th><th class="num">Min</th><th class="num">Max</th></tr></thead>
          <tbody>
            <% @call_stats.by_rpc.each do |r| %>
              <tr>
                <td><code><%= r[:rpc] %></code></td>
                <td class="num"><%= fmt_int.(r[:count]) %></td>
                <td class="num"><%= fmt_ms.(r[:mean_ms]) %> ms</td>
                <td class="num"><%= fmt_ms.(r[:min_ms]) %></td>
                <td class="num"><%= fmt_ms.(r[:max_ms]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div>
        <table>
          <thead><tr><th>By worker</th><th class="num">Calls</th><th class="num">RPCs</th></tr></thead>
          <tbody>
            <% @call_stats.by_worker.each do |w| %>
              <tr>
                <td><%= w[:worker_class] %></td>
                <td class="num"><%= fmt_int.(w[:count]) %></td>
                <td class="num"><small class="empty"><%= w[:rpcs].map { |r| r[:rpc] }.join(", ") %></small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="empty">No engine calls recorded yet.</p>
  <% end %>
</section>

<section>
  <h2>Jobs</h2>

  <form method="get" action="<%= monitoring_path %>" class="filters">
    <div class="filter-grid">
      <label>
        Job types
        <select name="job_types[]" multiple size="6" onchange="this.form.submit()">
          <% @job_types.each do |jt| %>
            <option value="<%= jt %>" <%= "selected" if @selected_types.include?(jt) %>><%= jt %></option>
          <% end %>
        </select>
      </label>

      <label>
        Status
        <select name="status" onchange="this.form.submit()">
          <option value="">All statuses</option>
          <% %w[ready complete failed error].each do |st| %>
            <option value="<%= st %>" <%= "selected" if @selected_status == st %>><%= st %></option>
          <% end %>
        </select>
      </label>

      <label>
        Process
        <select name="process" onchange="this.form.submit()">
          <option value="">All processes</option>
          <% @processes.each do |proc_id| %>
            <option value="<%= proc_id %>" <%= "selected" if @selected_process == proc_id %>><%= proc_id %></option>
          <% end %>
        </select>
      </label>
    </div>

    <p>
      <button type="submit">Apply</button>
      <a href="<%= monitoring_path %>" role="button" class="secondary outline">Clear</a>
      <% if @selected_types.any? %><small class="ops-tag">filtered: <%= @selected_types.join(", ") %></small><% end %>
    </p>
  </form>

  <h3>By type</h3>
  <table>
    <thead>
      <tr><th>Job type</th><th class="num">Total</th><th class="num">Complete</th><th class="num">Failed</th><th class="num">Error</th><th class="num">Mean total</th></tr>
    </thead>
    <tbody>
      <% @stats.by_job_type.each do |row| %>
        <tr>
          <td><code><%= row[:job_type] %></code></td>
          <td class="num"><%= row[:total] %></td>
          <td class="num status-complete"><%= row[:complete] %></td>
          <td class="num status-failed"><%= row[:failed] %></td>
          <td class="num status-error"><%= row[:error] %></td>
          <td class="num"><%= fmt_ms.(row[:mean_total_ms]) %> ms</td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h3>Recent runs <small>— each unfolds the gRPC calls it made (logging_context, the high-cardinality twin)</small></h3>
  <% if @runs.any? %>
    <table>
      <thead>
        <tr>
          <th>Job type</th><th>Status</th><th>Process</th><th>Element</th><th>Src</th>
          <th class="num">Buf</th><th class="num">Perform</th><th class="num">Total</th>
          <th class="num">Retries</th><th>Activated</th><th>Error</th>
        </tr>
      </thead>
      <tbody>
        <% @runs.each do |run| %>
          <% tags = run.tags || {} %>
          <tr>
            <td><code><%= run.job_type %></code></td>
            <td class="status-<%= run.status %>"><%= run.status %></td>
            <td><%= run.bpmn_process_id %></td>
            <td><%= tags["element_id"] %></td>
            <td><%= run.source %><%= " ⋯" if run.buffered %></td>
            <td class="num"><%= run.buffer_size.nil? ? "—" : run.buffer_size %></td>
            <td class="num"><%= fmt_ms.(run.perform_duration_ms) %></td>
            <td class="num"><%= fmt_ms.(run.total_duration_ms) %></td>
            <td class="num"><%= tags["retries"] %></td>
            <td><%= run.activated_at&.strftime("%H:%M:%S") %></td>
            <td><%= run.error_code || run.error_message&.truncate(40) %></td>
          </tr>
          <% calls = @calls_by_job[run.job_key] %>
          <% if calls&.any? %>
            <tr>
              <td colspan="11">
                <div class="call-seq">
                  <% calls.each do |call| %>
                    <span class="call-pill <%= "errored" if call.status == "errored" %>"><%= call.rpc %><span class="ms"><%= call.network_ms&.round %>ms</span></span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">No job runs match the current filter.</p>
  <% end %>
</section>
