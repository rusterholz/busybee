<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_CallActivityParent"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Busybee Test Suite"
                  exporterVersion="1.0">
  <bpmn:process id="call-activity-parent" name="Call Activity Parent" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="CallActivity_1"/>
    <bpmn:callActivity id="CallActivity_1" name="Call Child">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="call-activity-child" propagateAllChildVariables="false"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="CallActivity_1" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
